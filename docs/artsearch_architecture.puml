package "Review and model evaluation" #F8FAFC {
  component "Bluesky corpus gallery\nfilters + decision evidence" as BlueskyGallery #F3E8FF
  component "Review queue exporter\nboundary-prioritized CSV" as ReviewExport #F3E8FF
  component "Append-only label importer\nexact-repeat suppression" as LabelImport #F3E8FF
  component "Evaluation + calibration\nexact decision replay, metrics, sweeps" as Evaluation #F3E8FF
  component "Real-model smoke test\nfinite + batch/single checks" as SmokeTest #F3E8FF
}

package "Embedding and retrieval" #F8FAFC {
  component "Embedding pipeline\nvalidated processed artwork batches" as EmbedPipeline #FDECEC
  component "CLIP + DINOv2 provider\nsubject, pooled, patch features" as EmbeddingModels #FDECEC
  component "Qdrant serving publisher\nsafe/demo policy + model lineage" as QdrantPublisher #FDECEC
  component "CLIP + DINO ANN ensemble\nnamed vectors -> reciprocal-rank fusion" as Retrieval #FDECEC
  component "DINO patch precision stage\nshortlist-only exact MaxSim" as PatchReranker #FDECEC
  component "Exploration direction math\nmean delta / shift / orthogonalize" as Directions #FDECEC
  component "Retrieval workbench\nbrowse + human relevance evaluation" as Demo #FDECEC
  component "Retrieval evaluator\nP@K / MRR / MAP / nDCG" as RetrievalEvaluation #FDECEC
}

package "Versioned configuration" #F4F5F7 {
  artifact "config/config.yaml\npaths, image transforms, retrieval models" as AppConfig
  artifact "config/artists.yaml\nlocal manifest variant is ignored" as ArtistConfig
  artifact "config/bluesky_safe_pilot.local.txt\nmetadata-audited local roster" as SafePilotConfig
