  file "data/retrieval/judgments*.jsonl\ndata/retrieval/evaluation*.json" as RetrievalArtifacts
  database "data/artsearch.db\nSQLite metadata + vectors" as SQLite
  database "data/qdrant/\nrebuildable local serving index" as Qdrant #FFF8E7
  file "data/search_*.html\nlocal result galleries" as HTMLFiles
}

