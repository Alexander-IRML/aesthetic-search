  artifact "configs/artwork_filter.default.toml" as FilterConfig
  artifact "configs/artwork_filter.prompts.v1.toml" as PromptConfig
  artifact "configs/production.default.toml\nobject store + Qdrant serving policy" as ProductionConfig
}

package "Local private data boundary (Git-ignored)" #FFF8E7 {
  folder "data/raw/\nmanual + routed accepted originals" as RawFiles
  folder "data/processed/\ncanonical 448 x 448 JPEGs" as ProcessedFiles
  folder "data/filter/review_images/" as ReviewImages
  file "data/bluesky/*.jsonl\nImageCandidate audit stream" as CandidateJSONL
  file "data/bluesky/collection_checkpoints.jsonl\ncompleted actor/settings keys" as CheckpointJSONL
  file "data/filter/decisions*.jsonl\nFilterResult audit stream" as DecisionJSONL
  folder "data/cache/artwork_filter/\nimage + prompt embedding cache" as FeatureCache
