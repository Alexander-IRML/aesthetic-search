  entity "vector_index_points" as PGPoints
}

package "ingest" {
  entity "runs + filter evidence + source state" as PGIngest
  entity "sqlite_imports\nhash/scope/count verification" as PGImports
  queue "outbox_events\nSKIP LOCKED claims" as PGOutbox
}

package "discovery" {
  entity "campaigns + sources + observations" as PGDiscoverySources
  entity "graph entities + edges + evidence" as PGDiscoveryGraph
  queue "frontier_tasks\nleased + bounded retry" as PGDiscoveryFrontier
  entity "creator profiles + classification evidence" as PGDiscoveryEvidence
  entity "coverage + exclusions + removals" as PGDiscoveryPolicy
}

package "product (RLS-ready)" {
  entity "users + sessions + queries" as PGQueries
  entity "ranking_runs + retrieval_candidates\n+ impressions" as PGRankings
  entity "graded relevance + interactions\n+ saves + follows" as PGFeedback
}

database "Qdrant\nCLIP + CSD named HNSW" as PGQdrant
cloud "R2/S3\nprivate bytes + artifacts" as PGR2

Staging --> Publisher
Publisher --> PGArtists
Publisher --> PGArtworks
Publisher --> PGEmbeddings
Publisher --> PGIngest
Publisher --> PGImports
Publisher --> PGOutbox : same transaction
PGDiscoverySources --> PGDiscoveryGraph
PGDiscoveryGraph --> PGDiscoveryFrontier
PGDiscoveryEvidence --> PGDiscoveryFrontier : expansion score
PGDiscoveryPolicy --> PGDiscoveryFrontier : blocks/cancels work
PGDiscoveryPolicy --> PGOutbox : remove derived subject
PGArtworks --> PGR2 : object URI + content hash
PGModels --> PGEmbeddings
PGOutbox --> PGQdrant : idempotent upsert/delete
PGQdrant --> PGPoints : settlement after remote success
PGQueries --> PGRankings
PGRankings --> PGFeedback

note bottom of PGEmbeddings
  Compact archival/repair copy only.
  No PostgreSQL HNSW or IVFFlat index in this release.
end note

note bottom of PGFeedback
  Detailed events retain exact query/session,
  model/index version, scores, rank, and latency.
  Default retention: 180 days.
