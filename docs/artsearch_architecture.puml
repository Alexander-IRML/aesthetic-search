  component "Deterministic rules\nmedia + provenance" as Rules #FFF4D6
  component "Text signals\npost text + alt text" as TextSignals #FFF4D6
  component "SigLIP 2 zero-shot classifier\nversioned multi-class prompt bank" as ZeroShot #FFF4D6
  component "DecisionEngine\nACCEPT / REVIEW / REJECT / ERROR" as DecisionEngine #FFF4D6
