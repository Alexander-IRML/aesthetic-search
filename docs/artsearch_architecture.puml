  artist_id : TEXT <<FK>>
  raw_path : TEXT
  processed_path : TEXT?
  source_platform : TEXT
  source_id : TEXT? <<UNIQUE PAIR>>
  file_hash : TEXT?
  phash : TEXT?
  validated : INTEGER
  review_status : TEXT
  is_sfw : INTEGER?
  demo_eligible : INTEGER
  duplicate_of : TEXT? <<FK self>>
  transform_fields : scale / pad / crop
}

entity embeddings {
  * artwork_id : TEXT <<PK, FK>>
  --
  clip_vector : BLOB?
  csd_style : BLOB?
  dimensions : INTEGER fields
  CLIP_model_name_version : TEXT
  CSD_model_name_version : TEXT
}

entity runs {
  * run_id : INTEGER <<PK>>
  --
  script_name : TEXT
  started_at : TEXT
  finished_at : TEXT?
  processed_skipped_errors : INTEGER
}

entity run_events {
  * event_id : INTEGER <<PK>>
  --
  run_id : INTEGER? <<FK>>
  artwork_id : TEXT? <<FK>>
  level : TEXT
  event_type : TEXT
  raw_path : TEXT?
  message : TEXT
}

entity artwork_filter_decisions {
  * decision_key : TEXT <<PK>>
  --
  candidate_id : TEXT
  author_did : TEXT?
  post_uri : TEXT?
  decision : accept/review/reject/error
  predicted_class : TEXT
  route : TEXT
  scores_and_versions : scalar fields
  candidate_json : TEXT
  evidence_json : TEXT
  processed_at : TEXT
}

entity artwork_filter_routes {
  * route_key : TEXT <<PK>>
  --
  decision_key : TEXT <<FK, UNIQUE>>
  artwork_id : TEXT? <<FK>>
