@startuml ArtSearch_Bluesky_Pipeline_Sequence
title ArtSearch Bluesky Collection-to-Corpus Sequence

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceArrowThickness 1
skinparam responseMessageBelowArrow true
autonumber

actor Operator
participant "artsearch-bluesky-pipeline" as CLI
participant "BlueskyArtworkPipeline" as Pipeline
participant "BlueskyClient" as Client
participant "Public AppView" as AppView
database "Candidate JSONL" as Candidates
participant "ArtworkFilterService" as Filter
participant "Image loader" as Loader
participant "Rules + text signals" as Signals
database "Feature cache" as Cache
participant "SigLIP 2 + prompt bank" as SigLIP
database "Decision JSONL" as Decisions
participant "CorpusRouter" as Router
collections "Accepted / review files" as Files
participant "ArtworkFilterCorpusStore" as Store
database "SQLite" as DB

Operator -> CLI : run-author / run-authors
CLI -> Pipeline : process_stream(candidate iterator)

loop each actor and author-feed page
  Pipeline -> Client : get_author_feed(actor, cursor)
  Client -> AppView : GET app.bsky.feed.getAuthorFeed
  AppView --> Client : feed items + next cursor
  Client --> Pipeline : feed page

  loop each image view
    Pipeline -> Pipeline : apply public-safe Bluesky labels\nand adult-text exclusions
    alt blocked moderation signal
      Pipeline -> Pipeline : omit before candidate creation
    else allowed image
      Pipeline -> Pipeline : convert to ImageCandidate\n(DID, AT URI, URLs, text, labels, provenance)
      Pipeline -> Candidates : append candidate
    end
  end

  Pipeline -> Filter : classify_many(batch)
  Filter -> Loader : load preferred thumbnail\nwith byte/pixel/media limits
  Loader --> Filter : LoadedImage or typed error
  Filter -> Signals : deterministic media/provenance rules\nand text/alt-text scoring

  alt invalid media or permanent load failure
    Filter -> Filter : structured REJECT or ERROR
  else FORCE_REJECT rule
    Filter -> Filter : skip model inference
  else model-eligible candidate
    Filter -> Cache : get image embedding key
    alt cache miss
      Filter -> SigLIP : encode image batch
      SigLIP --> Filter : normalized embeddings
      Filter -> Cache : atomic vector + metadata write
    else cache hit
      Cache --> Filter : validated embedding
    end
    Filter -> SigLIP : score against cached versioned prompts
    SigLIP --> Filter : all class scores + utility/margin
    Filter -> Filter : DecisionEngine fusion and policy
  end

  Filter -> Decisions : append FilterResult evidence
  Filter --> Pipeline : ordered ACCEPT/REVIEW/REJECT/ERROR results
  Pipeline -> Router : route_many(candidates, results)

  alt ACCEPT
    Router -> Loader : load full-size image
    Router -> Files : re-encode without EXIF into accepted raw area
  else REVIEW and review download enabled
    Router -> Loader : load full-size image
    Router -> Files : isolate in review area
  else REJECT or ERROR
    Router -> Router : retain evidence; write no image bytes
  end

  Router --> Pipeline : RoutedImage outcomes
  Pipeline -> Store : persist_batch(candidates, results, routes)
  Store -> DB : append immutable decision + route audit rows
  alt accepted file stored
    Store -> Files : standardize to canonical processed JPEG
    Store -> DB : upsert artist + accepted artwork row
  else review stored
    Store -> DB : retain review route only
  end
end

Pipeline --> CLI : PipelineSummary counts
CLI --> Operator : JSON summary

note over Filter,SigLIP
  Automatic ACCEPT is disabled in the checked-in config
  until thresholds are validated and explicitly enabled.
  Deterministic-only mode never silently ACCEPTs.
  Model failures become ERROR, not REJECT.
end note

note over Router,DB
  Classification does not establish attribution,
  copyright permission, safety, or opt-out status.
end note

@enduml


@startuml ArtSearch_SigLIP_To_Retrieval_Rebuild
title ArtSearch SigLIP-to-Retrieval Corpus Rebuild

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceArrowThickness 1
autonumber

actor Operator
participant "Corpus rebuild CLI" as CLI
database "Candidate JSONL" as Candidates
database "Decision JSONL" as Decisions
participant "SigLIP corpus selector" as Selector
collections "Prior active corpus archive" as Archive
participant "CorpusRouter" as Router
participant "ArtworkFilterCorpusStore" as Store
database "Fresh SQLite + image files" as Corpus
participant "Pinned CLIP + DINO" as HeavyML
participant "Retrieval gallery writer" as Gallery

Operator -> CLI : --dry-run
CLI -> Candidates : load latest candidate per ID
CLI -> Decisions : load decision history
CLI -> Selector : require current CID and config hash
Selector -> Selector : keep artwork-like classes;\nexclude reject/error/routing/repost/quote
Selector --> Operator : exact selection counts

Operator -> CLI : --confirm-replace
CLI -> Archive : move prior DB, raw, processed,\nand retrieval HTML
loop selected candidates in batches
  CLI -> Router : promoted ACCEPT + full-size source
  Router -> Corpus : metadata-stripped raw JPEG
  CLI -> Store : candidate + evidence + route
  Store -> Corpus : canonical 448x448 JPEG + SQLite upsert
end
CLI -> HeavyML : embed every validated artwork
HeavyML -> Corpus : CLIP vector + DINO pooled + DINO patches
CLI -> Gallery : two-stage ensemble gallery,\nsame-artist results enabled
Gallery -> Corpus : read pinned vectors and local images
Gallery --> Operator : data/search_gallery.html

note over Selector,Store
  Original SigLIP decision JSONL is not rewritten.
  Promotion is explicit SQLite seed evidence with
  reason accept.siglip_corpus_seed.
end note

@enduml


@startuml ArtSearch_SQLite_Data_Model
title ArtSearch SQLite Data Model

hide methods
hide stereotypes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName SansSerif
skinparam classBorderColor #374151
skinparam classBackgroundColor #F8FAFC

entity artists {
  * artist_id : TEXT <<PK>>
  --
  display_name : TEXT
  folder_name : TEXT <<UNIQUE>>
  source_platform : TEXT
  source_url : TEXT?
}

entity artworks {
  * artwork_id : TEXT <<PK>>
  --
  artist_id : TEXT <<FK>>
  raw_path : TEXT
  processed_path : TEXT?
  source_platform : TEXT
  source_id : TEXT? <<UNIQUE PAIR>>
  file_hash : TEXT?
  phash : TEXT?
  validated : INTEGER
  review_status : TEXT
  is_sfw : INTEGER?
  demo_eligible : INTEGER
  duplicate_of : TEXT? <<FK self>>
  transform_fields : scale / pad / crop
}

entity embeddings {
  * artwork_id : TEXT <<PK, FK>>
  --
  clip_vector : BLOB?
  dino_pooled : BLOB?
  dino_patches : BLOB?
  dimensions : INTEGER fields
  CLIP_model_name_version : TEXT
  DINO_model_name_version : TEXT
}

entity runs {
  * run_id : INTEGER <<PK>>
  --
  script_name : TEXT
  started_at : TEXT
  finished_at : TEXT?
  processed_skipped_errors : INTEGER
}

entity run_events {
  * event_id : INTEGER <<PK>>
  --
  run_id : INTEGER? <<FK>>
  artwork_id : TEXT? <<FK>>
  level : TEXT
  event_type : TEXT
  raw_path : TEXT?
  message : TEXT
}

entity artwork_filter_decisions {
  * decision_key : TEXT <<PK>>
  --
  candidate_id : TEXT
  author_did : TEXT?
  post_uri : TEXT?
  decision : accept/review/reject/error
  predicted_class : TEXT
  route : TEXT
  scores_and_versions : scalar fields
  candidate_json : TEXT
  evidence_json : TEXT
  processed_at : TEXT
}

entity artwork_filter_routes {
  * route_key : TEXT <<PK>>
  --
  decision_key : TEXT <<FK, UNIQUE>>
  artwork_id : TEXT? <<FK>>
  candidate_id : TEXT
  target : corpus/review
  status : stored/duplicate/error
  local_path : TEXT?
  hashes_dimensions_errors : fields
}

entity artwork_objects {
  * artwork_id : TEXT <<PK, FK>>
  * role : original <<PK>>
  --
  object_key : TEXT
  object_uri : TEXT
  content_sha256 : TEXT
  byte_size : INTEGER
  etag : TEXT?
  published_at : TEXT
  verified_at : TEXT
}

entity vector_index_points {
  * collection_name : TEXT <<PK>>
  * artwork_id : TEXT <<PK, FK>>
  --
  point_id : TEXT <<UNIQUE per collection>>
  content_hash : TEXT
  indexed_at : TEXT
}

artists ||--o{ artworks : owns
artworks ||--o| embeddings : has
runs ||--o{ run_events : records
artworks o|--o{ run_events : referenced by
artworks o|--o{ artworks : duplicate_of
artwork_filter_decisions ||--o| artwork_filter_routes : routes
artworks o|--o{ artwork_filter_routes : imported as
artworks ||--o| artwork_objects : published as
artworks ||--o{ vector_index_points : indexed as

note bottom of artwork_filter_decisions
  JSONL remains the append-only offline decision stream.
  This table provides queryable, versioned audit evidence.
end note

note bottom of embeddings
  Vectors are stored as normalized NumPy-compatible BLOBs.
  Search only loads rows matching configured model versions.
end note

note bottom of artwork_objects
  Checkpoints immutable local or S3-compatible originals.
  Missing objects are repaired from the accepted working cache.
end note

note bottom of vector_index_points
  Idempotency ledger for the derived Qdrant serving index.
  Qdrant remains rebuildable from current SQLite vectors and policy.
end note

@enduml
