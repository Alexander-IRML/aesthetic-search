# Local Docker development only. The real `.env` file is ignored by Git.
ARTSEARCH_POSTGRES_PASSWORD=artsearch-local-only
# Match bind-mounted data ownership in Linux/WSL (`id -u` and `id -g`).
ARTSEARCH_UID=1000
ARTSEARCH_GID=1000
AIRFLOW_UID=50000
AIRFLOW_PORT=8081
ARTSEARCH_DASHBOARD_PORT=8765
ARTSEARCH_API_PORT=8000
ARTSEARCH_QDRANT_HTTP_PORT=6335
ARTSEARCH_QDRANT_GRPC_PORT=6336
ARTSEARCH_INTAKE_SCHEDULE=
ARTSEARCH_SPARK_AUDIT_SCHEDULE=
ARTSEARCH_PRODUCTION_CONFIG=configs/production.default.toml
ARTSEARCH_ACTORS_FILE=config/bluesky_actors.local.txt

# Required only when the intake production config uses Cloudflare R2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=auto
