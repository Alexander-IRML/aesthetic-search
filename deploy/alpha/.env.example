# Copy to deploy/alpha/.env on the VM. The real file is ignored by Git.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# Airflow uses its local metadata database until an external PostgreSQL URL is
# supplied. Keep this distinct from the future ArtSearch application database.
AIRFLOW_DATABASE_URL=

# Use a UTC cron expression here. Keep empty until the manual cloud canary passes.
ARTSEARCH_INTAKE_SCHEDULE=
ARTSEARCH_SPARK_AUDIT_SCHEDULE=
ARTSEARCH_PRODUCTION_CONFIG=configs/production.alpha-cloud.local.toml
ARTSEARCH_ACTORS_FILE=config/bluesky_actors.local.txt

# Cloudflare R2 S3 credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=auto

# Qdrant Cloud database credentials.
QDRANT_URL=
QDRANT_API_KEY=

# Neon pooled runtime and direct migration/cutover endpoints. The deployment
# helper derives both from the single URL copied from Neon's Connect dialog.
# Keep the direct endpoint out of the public API container after cutover.
DATABASE_URL=
DATABASE_DIRECT_URL=
ARTSEARCH_SESSION_SECRET=
ARTSEARCH_VISITOR_HASH_SECRET=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
